const shortcuts = [
  ['Tab', 'Zwischen den Panels wechseln'],
  ['Enter / Doppelklick', 'Ordner, Archiv oder Datei öffnen'],
  ['Rücktaste / ⌘↑', 'In den übergeordneten Ordner wechseln'],
  ['⌘L', 'Einen Pfad eingeben'],
  ['⌥↓', 'Favoriten des aktiven Panels öffnen'],
  ['⌘A', 'Alle Einträge auswählen'],
  ['F1', 'Tastaturhilfe öffnen'],
  ['Leertaste / F3 / ⌘Y', 'Quick Look anzeigen'],
  ['F4', 'Datei in TextEdit bearbeiten'],
  ['F5 / F6', 'Ins andere Panel kopieren / verschieben'],
  ['F7 / ⌘⇧N', 'Einen Ordner anlegen'],
  ['F8 / ⌘⌫', 'In den Papierkorb legen; Archiveinträge endgültig löschen'],
  ['F9', 'Die Menüs im Fenster öffnen'],
  ['⌘R', 'Beide Panels und den Git-Status aktualisieren'],
  ['⌘⇧.', 'Versteckte Dateien ein- oder ausblenden'],
  ['⌘U', 'Die Panelpfade tauschen'],
  ['⌘⇧R', 'Den gewählten Eintrag im Finder zeigen'],
  ['⌘⇧F', 'Datei- und Textsuche öffnen'],
  ['⌘⇧G', 'Das Git-Fenster öffnen'],
  ['⌘K', 'Das Verbindungsarchiv öffnen'],
  ['Esc / Ctrl-G', 'Menü oder Dialog schließen; laufende Aufgabe abbrechen'],
  ['F10', 'In der Dateiliste beenden; in Menüs und Dialogen abbrechen'],
