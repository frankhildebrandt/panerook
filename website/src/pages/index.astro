---
import SiteLayout from '../layouts/SiteLayout.astro';
import { release, repository, version } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const documentation = `${base}/dokumentation/`;
const features = [
  {
    number: '01', tag: 'DATEIEN & NAVIGATION', title: 'Zwei Panels. Ein Arbeitsfluss.',
    description: 'Quellordner links, Zielordner rechts. Kopiere und verschiebe deine Auswahl direkt zwischen den Panels und behalte beide Seiten im Blick.',
    details: ['Mit Tab das Panel wechseln, mit F5 kopieren und mit F6 verschieben.', 'Favoriten, Verlauf und Dateimasken verkürzen wiederkehrende Wege.', 'Quick Look, Schnellansicht und Dateiinfos helfen bei der Auswahl.'],
    image: 'panels.png', width: 2360, height: 1480, alt: 'PaneRook mit zwei nativen Dateipanels, Pfadzeilen und der Funktionstastenleiste.',
    caption: 'Zwei unabhängige Dateilisten und die wichtigsten Aktionen direkt im Fenster.', anchor: 'erste-schritte', link: 'Die Panels kennenlernen',
  },
  {
    number: '02', tag: 'GIT & WORKTREES', title: 'Vom Unterschied zum Commit.',
    description: 'Erkenne den Repository-Status im Dateipanel und öffne die Git-Werkzeuge direkt über die Branchanzeige. So bleiben Dateien und Versionsverwaltung zusammen.',
    details: ['Unified oder Side-by-Side: Diffs mit Zeilennummern und farbigen Änderungen lesen.', 'Dateien stagen, Commits erstellen und Verlauf, Branches oder Stashes öffnen.', 'Besuchte Repositories und ihre Worktrees über die Favoriten wiederfinden.'],
    image: 'git-diff.png', width: 2360, height: 1440, alt: 'Git-Fenster von PaneRook mit einer Side-by-Side-Gegenüberstellung einer geänderten Textdatei.',
    caption: 'Vorher und Nachher nebeneinander: Änderungen direkt im Git-Fenster prüfen.', anchor: 'git', link: 'Mit Git arbeiten',
  },
  {
    number: '03', tag: 'ZIP, TAR & TGZ', title: 'Archive wie Ordner öffnen.',
    description: 'Öffne ein Archiv mit Enter und navigiere durch seine Unterordner im gewohnten Dateipanel. Kopiere gezielt einzelne Inhalte, ohne vorher alles in einen Ordner zu entpacken.',
    details: ['Dateien und Ordner zwischen lokalem Ordner und Archiv kopieren.', 'Einträge umbenennen, verschieben und neue Ordner im Archiv anlegen.', 'Ausgewählte Inhalte für Quick Look als temporäre Kopie bereitstellen.'],
    image: 'archives.png', width: 2360, height: 1480, alt: 'Ein geöffnetes ZIP-Archiv im PaneRook-Dateipanel neben einem lokalen Ordner.',
    caption: 'Der Archivinhalt bleibt im Panel navigierbar, der lokale Ordner daneben erreichbar.', anchor: 'archive', link: 'Archive öffnen und bearbeiten',
  },
  {
    number: '04', tag: 'REMOTE & VERBINDUNGEN', title: 'Deine Ziele. Immer griffbereit.',
    description: 'Speichere wiederkehrende FTP-, SSH-, SFTP- und Nextcloud-Verbindungen im durchsuchbaren Verbindungsarchiv. Öffne eine Verbindung direkt im ausgewählten Panel und übertrage Dateien zum gegenüberliegenden lokalen Panel.',
    details: ['Remote-Ordner durchsuchen, Dateien hoch- und herunterladen.', 'Verbindungen nach Name, Server, Benutzer oder Protokoll finden.', 'SSH-Schlüssel oder Agent nutzen; Nextcloud über HTTPS und App-Passwort verbinden.'],
    image: 'connections.png', width: 1700, height: 984, alt: 'Das durchsuchbare Verbindungsarchiv von PaneRook mit gespeicherten Demo-Verbindungen.',
    caption: 'Verbindungsdaten zentral verwalten; Passwörter werden nicht im Archiv gespeichert.', anchor: 'remote', link: 'Remote-Verbindungen einrichten',
  },
];
const tools = [
  { title: 'Finden und vergleichen', description: 'Dateien und Text rekursiv suchen, Treffer ins Panel übernehmen, Ordnergrößen berechnen und Dateien oder Verzeichnisse vergleichen.', anchor: 'suche-aufgaben' },
  { title: 'Aufgaben im Hintergrund', description: 'Längere Aktionen zeigen ihren Fortschritt und lassen sich abbrechen oder in den Hintergrund legen. Weitere Aufgaben starten der Reihe nach.', anchor: 'suche-aufgaben' },
  { title: 'Auf deinem Mac zu Hause', description: 'Native AppKit-Oberfläche, Quick Look, Finder-Anbindung und helle oder dunkle Darstellung. Ab macOS 26 mit Liquid Glass.', anchor: 'einstellungen' },
];
const shortcuts = [['Tab', 'Panel wechseln'], ['F3', 'Quick Look'], ['F5', 'Kopieren'], ['F6', 'Verschieben'], ['F7', 'Neuer Ordner'], ['⌘K', 'Verbindungen']];
---

<SiteLayout title="PaneRook · Zwei Panels. Alles im Griff." description="PaneRook ist ein nativer macOS-Dateimanager mit zwei Panels, Tastaturbedienung, Git-Diffs, Archiven und Remote-Verbindungen.">
  <main id="inhalt">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="eyebrow"><span class="status-dot" aria-hidden="true"></span> NATIV FÜR MACOS · VERSION {version}</div>
      <h1 id="hero-title">Zwei Panels.<br /><span>Alles im Griff.</span></h1>
      <p class="hero-copy">Deine Dateien, direkt auf Kurs. PaneRook verbindet den Arbeitsfluss von Midnight Commander mit einer nativen Mac-Oberfläche.</p>
      <div class="hero-actions">
        <a class="button primary" href={release}>Für macOS herunterladen <span aria-hidden="true">↓</span></a>
        <a class="button secondary" href={documentation}>Installation & erste Schritte <span aria-hidden="true">→</span></a>
      </div>
      <p class="requirements">Ab macOS 14 · Apple Silicon & Intel</p>
      <figure class="hero-screenshot">
        <a href={`${base}/screenshots/releases/0.3.0/panels.png`} aria-label="Screenshot der beiden Dateipanels in voller Größe öffnen">
          <img src={`${base}/screenshots/releases/0.3.0/panels.png`} width="4112" height="2466" alt="Die native PaneRook-App mit zwei Dateipanels und einer Leiste für die Funktionstasten." fetchpriority="high" />
        </a>
        <figcaption>PaneRook auf macOS · App-Screenshot mit Beispieldateien</figcaption>
      </figure>
      <div class="shortcut-strip" aria-label="Die wichtigsten Tastaturkürzel">
        {shortcuts.map(([key, action]) => <span><kbd>{key}</kbd>{action}</span>)}
      </div>
    </section>

    <section class="features wrap" id="funktionen" aria-labelledby="features-title">
      <div class="section-intro">
        <p class="eyebrow">WENIGER UMWEGE</p>
        <h2 id="features-title">Die Werkzeuge für deinen Alltag.<br />Direkt an deinen Dateien.</h2>
        <p>Von der schnellen Kopie bis zum Git-Diff: Entdecke die Funktionen in echten App-Ansichten und finde die passende Anleitung dazu.</p>
      </div>
      <div class="feature-list">
        {features.map(feature => (
          <article class="feature" aria-labelledby={`feature-${feature.number}`}>
            <div class="feature-copy">
              <p class="feature-tag"><span>{feature.number}</span>{feature.tag}</p>
              <h3 id={`feature-${feature.number}`}>{feature.title}</h3>
              <p>{feature.description}</p>
              <ul>{feature.details.map(detail => <li>{detail}</li>)}</ul>
              <a class="text-link" href={`${documentation}#${feature.anchor}`}>{feature.link} <span aria-hidden="true">→</span></a>
            </div>
            <figure class="feature-screenshot">
              <a href={`${base}/screenshots/${feature.image}`} aria-label={`${feature.title} Screenshot in voller Größe öffnen`}>
                <img src={`${base}/screenshots/${feature.image}`} width={feature.width} height={feature.height} alt={feature.alt} loading="lazy" decoding="async" />
              </a>
              <figcaption>{feature.caption}</figcaption>
            </figure>
          </article>
        ))}
      </div>
      <div class="tool-grid">
        {tools.map(tool => <article><h3>{tool.title}</h3><p>{tool.description}</p><a class="text-link" href={`${documentation}#${tool.anchor}`}>Mehr erfahren <span aria-hidden="true">→</span></a></article>)}
      </div>
      <p class="feature-note">Du möchtest einen Ablauf genauer kennenlernen? <a href={documentation}>Zur vollständigen Dokumentation →</a></p>
    </section>

    <section class="installation wrap" id="installation" aria-labelledby="installation-title">
      <div>
        <p class="eyebrow">VERSION {version}</p>
        <h2 id="installation-title">Bereit für deinen Mac.</h2>
        <p>Lade das Universal-DMG für Apple Silicon und Intel herunter, öffne es und ziehe PaneRook auf die Verknüpfung zum Programme-Ordner. Alternativ steht ein ZIP zum Entpacken bereit.</p>
        <p class="install-note">Zu beiden Downloads gibt es eine SHA-256-Prüfsumme. Von Version 0.1.1 bitte einmal manuell aktualisieren; danach sind Updates direkt in der App möglich.</p>
        <div class="install-links"><a class="text-link" href={`${documentation}#installation`}>Installationsanleitung →</a><a class="text-link" href={`${base}/release-notes/${version}/`}>Was ist neu? Release Notes →</a></div>
      </div>
      <div class="source-card">
        <span class="source-label">SELBER BAUEN</span><p>Swift + AppKit.<br />Direkt aus dem Repository.</p>
        <pre><code>git clone {repository}.git
cd panerook
make run</code></pre>
        <a href={`${repository}#starten`}>Voraussetzungen & Entwicklung <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .hero { padding-top: 66px; text-align: center; }
  .eyebrow { display: flex; align-items: center; justify-content: center; gap: 9px; color: #b9a0ed; font-size: 11px; font-weight: 650; letter-spacing: 1.9px; }
  .status-dot { width: 6px; height: 6px; border-radius: 100%; background: #ba98ff; box-shadow: 0 0 12px #ab7cfa88; }
  h1 { margin: 26px 0 25px; font-size: clamp(54px, 7.5vw, 88px); line-height: 1.04; letter-spacing: -5px; font-weight: 650; }
  h1 span { color: #bfa1f6; }
  .hero-copy { max-width: 540px; margin: 0 auto 28px; font-size: 17px; color: #bcb4c8; }
  .hero-actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
  .button { min-height: 46px; display: inline-flex; gap: 20px; align-items: center; justify-content: center; padding: 12px 19px; border-radius: 7px; font-size: 13px; font-weight: 600; transition: background .2s; }
  .primary { color: #fff; background: #8853df; border: 1px solid #a879f0; box-shadow: 0 4px 20px #8b4ce221; }
  .primary:hover { background: #9a68ec; color: #fff; }
  .secondary { color: #ddd5e8; border: 1px solid #443b50; background: #211c2a; }
  .requirements { margin: 16px 0 42px; font-size: 11px; color: #aaa0b8; }
  figure { margin: 0; min-width: 0; }
  figure > a { display: block; overflow: hidden; border: 1px solid #554762; border-radius: 10px; background: #24212c; box-shadow: 0 18px 60px #0004; }
  figure img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 14px; color: #a89ab6; font-size: 11px; line-height: 1.6; }
  .hero-screenshot { max-width: 1000px; margin-inline: auto; }
  .hero-screenshot > a { box-shadow: 0 30px 90px #0005, 0 -10px 100px #9f6cf514; }
  .shortcut-strip { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 28px; margin-top: 32px; }
  .shortcut-strip span { display: inline-flex; gap: 9px; align-items: center; font-size: 11px; color: #b7a9c6; }
  kbd { min-width: 30px; padding: 5px 7px; border: 1px solid #53435f; border-bottom-width: 2px; border-radius: 5px; background: #251d2e; color: #d8baff; font-size: 11px; }
  .features { padding-block: 104px 64px; }
  .section-intro { max-width: 700px; }
  .section-intro .eyebrow, .installation .eyebrow { justify-content: start; }
  h2 { font-size: clamp(30px, 4vw, 41px); line-height: 1.16; letter-spacing: -1.6px; font-weight: 600; margin-bottom: 20px; }
  .section-intro > p:last-child { max-width: 530px; color: #b7adbf; font-size: 15px; }
  .feature-list { margin-top: 54px; }
  .feature { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.3fr); align-items: center; gap: 48px; padding-block: 48px; border-top: 1px solid #40334c; }
  .feature:nth-child(even) { grid-template-columns: minmax(0, 1.3fr) minmax(0, .85fr); }
  .feature:nth-child(even) .feature-copy { order: 2; }
  .feature-tag { display: flex; gap: 12px; align-items: center; color: #b193d7; font-size: 10px; font-weight: 600; letter-spacing: 1.5px; }
  .feature-tag span { color: #9f81bf; font-variant-numeric: tabular-nums; letter-spacing: 0; }
  h3 { margin-block: 20px 14px; font-size: clamp(23px, 3vw, 30px); line-height: 1.18; font-weight: 600; letter-spacing: -.8px; }
  .feature-copy > p:not(.feature-tag) { font-size: 14px; color: #b8adc4; }
  .feature-copy ul { padding-left: 17px; margin-block: 20px; font-size: 12px; line-height: 1.8; color: #b8adc4; }
  .feature-copy li { margin-bottom: 8px; padding-left: 3px; }
  .feature-copy li::marker { color: #a17bc8; }
  .text-link { display: inline-block; color: #c2a2f2; margin-top: 8px; font-size: 13px; line-height: 1.7; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .tool-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 24px; }
  .tool-grid article { padding: 25px; border: 1px solid #40334c; border-radius: 9px; background: #201b28; }
  .tool-grid h3 { margin-top: 0; font-size: 18px; line-height: 1.35; letter-spacing: -.3px; }
  .tool-grid p { margin-bottom: 10px; font-size: 13px; color: #b8adc4; }
  .tool-grid a { font-size: 12px; }
  .feature-note { margin: 28px 0 0; color: #a99bb8; font-size: 12px; line-height: 1.9; }
  .feature-note a { color: #c2a2f2; }
  .installation { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; padding-block: 64px 86px; border-top: 1px solid #382f42; }
  .installation p:not(.eyebrow) { color: #b1a6bf; font-size: 14px; }
  .installation .install-note { font-size: 12px !important; color: #c1b2ce !important; }
  .install-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .source-card { align-self: center; min-width: 0; border: 1px solid #42374d; padding: 27px; border-radius: 9px; background: #201b28; }
  .source-label { font-size: 10px; color: #ac91cc; letter-spacing: 1.5px; }
  .source-card p { margin-block: 16px; color: #e9e0f4 !important; font-size: 19px !important; line-height: 1.45; }
  pre { padding: 15px; margin: 20px 0; overflow-x: auto; border-radius: 5px; border: 1px solid #383040; background: #18131f; color: #c9b2e8; font-size: 10px; line-height: 1.9; }
  .source-card > a { font-size: 11px; color: #bcb0cc; }
  @media (max-width: 900px) {
    .feature, .feature:nth-child(even) { gap: 28px; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .tool-grid { gap: 14px; }
    .tool-grid article { padding: 20px; }
    .installation { gap: 32px; }
  }
  @media (max-width: 700px) {
    .feature, .feature:nth-child(even) { grid-template-columns: 1fr; gap: 28px; padding-block: 36px; }
    .feature:nth-child(even) .feature-copy { order: 0; }
    .feature-copy { max-width: 530px; }
    .tool-grid { grid-template-columns: 1fr; gap: 14px; }
    .tool-grid article { padding: 24px; }
  }
  @media (max-width: 600px) {
    .hero { padding-top: 36px; }
    h1 { letter-spacing: -2.8px; }
    .hero-copy { font-size: 15px; }
    .eyebrow { font-size: 9px; letter-spacing: 1.5px; }
    .hero-actions { flex-direction: column; max-width: 310px; margin-inline: auto; }
    .requirements { font-size: 10px; line-height: 1.8; margin-bottom: 30px; }
    .shortcut-strip { justify-content: start; gap: 14px; display: grid; grid-template-columns: repeat(3, 1fr); }
    .shortcut-strip span { flex-direction: column; align-items: center; gap: 7px; font-size: 10px; }
    .features { padding-block: 68px 44px; }
    .section-intro > p:last-child { font-size: 14px; }
    .feature-list { margin-top: 36px; }
    .installation { grid-template-columns: 1fr; padding-block: 48px; gap: 30px; }
    .source-card { padding: 22px; }
  }
  @media (prefers-reduced-motion: reduce) { .button { transition: none; } }
</style>
