---
const repository = 'https://github.com/frankhildebrandt/panerook';
const release = `${repository}/releases/tag/v0.2.0`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const icon = `${base}/icon.svg`;
const description = 'PaneRook ist ein nativer macOS-Dateimanager mit zwei Panels, direkter Tastaturbedienung, Archiven und Remote-Verbindungen.';
const features = [
  { number: '01', title: 'Zwei Panels. Ein Arbeitsfluss.', description: 'Ordner unabhängig öffnen, Dateien direkt ins andere Panel kopieren oder verschieben. Favoriten, Verlauf und Filter halten deine Wege kurz.' },
  { number: '02', title: 'Die Tastatur gibt den Takt vor.', description: 'Tab wechselt das Panel, F5 kopiert, F6 verschiebt. Vertraute Commander-Bedienung trifft auf native macOS-Menüs und Quick Look.' },
  { number: '03', title: 'Archive wie Ordner öffnen.', description: 'ZIP, TAR und TGZ direkt durchsuchen. Dateien hinein- und herauskopieren, umbenennen und organisieren, ohne vorher alles zu entpacken.' },
  { number: '04', title: 'Lokal arbeiten. Weiter verbinden.', description: 'FTP, SSH, SFTP und Nextcloud über separate Remote-Browser erreichen. Wiederkehrende Ziele bleiben im Verbindungsarchiv griffbereit.' },
];
const shortcuts = [ ['Tab', 'Panel wechseln'], ['F3', 'Quick Look'], ['F5', 'Kopieren'], ['F6', 'Verschieben'], ['F7', 'Neuer Ordner'], ['⌘K', 'Verbindungen'] ];
const files = [ ['Dokumente', 'Ordner', 'folder'], ['Projekte', 'Ordner', 'folder'], ['Entwürfe.zip', '12,4 MB', 'archive'], ['Notizen.md', '2 KB', 'file'] ];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17141e" />
    <meta property="og:title" content="PaneRook · Zwei Panels. Alles im Griff." />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(base + '/', Astro.site)} />
    <meta property="og:image" content={new URL(base + '/icon.png', Astro.site)} />
    <link rel="canonical" href={new URL(base + '/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={icon} />
    <title>PaneRook · Zwei Panels. Alles im Griff.</title>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt</a>
    <header class="site-header wrap">
      <a class="brand" href={`${base}/`} aria-label="PaneRook Startseite"><img src={icon} width="38" height="38" alt="" /><span>PaneRook</span></a>
      <nav aria-label="Hauptnavigation">
        <a href="#funktionen">Funktionen</a>
        <a href={`${repository}#readme`}>Handbuch <span aria-hidden="true">↗</span></a>
        <a class="nav-github" href={repository}>GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="inhalt">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="eyebrow"><span class="status-dot" aria-hidden="true"></span> NATIV FÜR MACOS · VERSION 0.2.0</div>
        <h1 id="hero-title">Zwei Panels.<br /><span>Alles im Griff.</span></h1>
        <p class="hero-copy">Deine Dateien, direkt auf Kurs. PaneRook verbindet den Arbeitsfluss von Midnight Commander mit einer nativen Mac-Oberfläche.</p>
        <div class="hero-actions">
          <a class="button primary" href={release}>Für macOS herunterladen <span aria-hidden="true">↓</span></a>
          <a class="button secondary" href={repository}>Quellcode ansehen <span aria-hidden="true">↗</span></a>
        </div>
        <p class="requirements">Ab macOS 14 · Apple Silicon & Intel · <a href="#installation">Installationshinweise</a></p>

        <div class="app-illustration" role="img" aria-label="Schematische Darstellung: zwei Dateipanels mit Ordnern und einer Funktionstastenleiste.">
          <div class="window-bar"><div class="traffic-lights"><i></i><i></i><i></i></div><span>PaneRook</span><span class="window-menu">☰</span></div>
          <div class="panes">
            <div class="pane active">
              <div class="path"><span class="home-icon">⌂</span> / Benutzer / Zuhause <span>⌄</span></div>
              <div class="column-labels"><span>Name</span><span>Größe</span></div>
              <div class="file-row parent"><span>↰ &nbsp; ..</span><span></span></div>
              {files.map(([name, size, type], i) => <div class:list={['file-row', { selected: i === 1 }]}><span><b class={type}>{type === 'folder' ? '▰' : type === 'archive' ? '▤' : '▱'}</b>{name}</span><span>{size}</span></div>)}
              <div class="pane-status">4 Einträge <span>1 ausgewählt</span></div>
            </div>
            <div class="pane">
              <div class="path"><span class="home-icon">⌂</span> / Benutzer / Archiv <span>⌄</span></div>
              <div class="column-labels"><span>Name</span><span>Größe</span></div>
              <div class="file-row parent"><span>↰ &nbsp; ..</span><span></span></div>
              <div class="file-row"><span><b class="folder">▰</b>Fotos</span><span>Ordner</span></div>
              <div class="file-row"><span><b class="folder">▰</b>Backups</span><span>Ordner</span></div>
              <div class="file-row"><span><b class="file">▱</b>Übersicht.pdf</span><span>820 KB</span></div>
              <div class="file-row placeholder"><span>&nbsp;</span></div>
              <div class="pane-status">3 Einträge <span>Bereit</span></div>
            </div>
          </div>
          <div class="function-bar">{shortcuts.map(([key, action]) => <span><b>{key}</b>{action}</span>)}</div>
        </div>
        <p class="illustration-caption">Der Arbeitsfluss auf einen Blick · Schematische Ansicht</p>
      </section>

      <section class="features wrap" id="funktionen" aria-labelledby="features-title">
        <div class="section-intro"><p class="eyebrow">WENIGER UMWEGE</p><h2 id="features-title">Platz für deine Dateien.<br />Tempo für deine Arbeit.</h2><p>Von der schnellen Kopie bis zur Remote-Verbindung: Die Werkzeuge bleiben dort, wo du sie brauchst.</p></div>
        <div class="feature-grid">{features.map(feature => <article><span class="feature-number">{feature.number}</span><h3>{feature.title}</h3><p>{feature.description}</p></article>)}</div>
        <div class="detail-strip"><span>Dateisuche & Vergleiche</span><span>Aufgaben-Queue mit Fortschritt</span><span>Favoriten & Netzwerkfreigaben</span><span>Hell & Dunkel</span></div>
      </section>

      <section class="installation wrap" id="installation" aria-labelledby="installation-title">
        <div><p class="eyebrow">VERSION 0.2.0</p><h2 id="installation-title">Bereit für deinen Mac.</h2><p>Version 0.2.0 bringt Git-Werkzeuge, Side-by-Side-Diffs und automatische Update-Prüfungen. Lade das Universal-DMG für Apple Silicon und Intel auf GitHub herunter, öffne es und ziehe PaneRook auf die Verknüpfung zum Programme-Ordner. Alternativ steht ein ZIP zum Entpacken bereit.</p><p class="install-note">App und DMG sind mit Apple Developer ID signiert und von Apple notarisiert. Zu beiden Downloads gibt es eine SHA-256-Prüfsumme zur Überprüfung. Von Version 0.1.1 bitte einmal manuell aktualisieren; danach sind Updates direkt in der App möglich.</p><a class="text-link" href={release}>Zu Download & Release-Hinweisen <span aria-hidden="true">↗</span></a></div>
        <div class="source-card"><span class="source-label">SELBER BAUEN</span><p>Swift + AppKit.<br />Direkt aus dem Repository.</p><pre><code>git clone {repository}.git
cd panerook
./scripts/build-app.sh release</code></pre><a href={`${repository}#starten`}>Voraussetzungen & Anleitung <span aria-hidden="true">↗</span></a></div>
      </section>
    </main>

    <footer class="site-footer wrap"><a class="brand" href={`${base}/`}><img src={icon} width="28" height="28" alt="" /><span>PaneRook</span></a><p>Ein nativer Dateimanager. Inspiriert von Midnight Commander.</p><a href={repository}>Auf GitHub mitarbeiten <span aria-hidden="true">↗</span></a></footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 32px; }
  :global(body) { margin: 0; color: #f3f0f8; background: #17141e; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 3px solid #c8b0ff; outline-offset: 5px; border-radius: 4px; }
  :global(a:hover) { color: #dccdff; }
  :global(p) { line-height: 1.7; }
  :global(h1), :global(h2), :global(h3), :global(p) { margin-top: 0; }
  .wrap { width: min(1120px, calc(100% - 64px)); margin-inline: auto; }
  .skip-link { position: absolute; left: 16px; top: -60px; padding: 12px; background: #fff; color: #17141e; z-index: 10; }
  .skip-link:focus { top: 16px; }
  .site-header { min-height: 100px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-size: 18px; font-weight: 650; letter-spacing: -.5px; }
  .brand img { display: block; }
  nav { display: flex; gap: 30px; align-items: center; font-size: 13px; color: #bfb7cc; }
  .nav-github { padding: 9px 15px; border: 1px solid #48404f; border-radius: 7px; color: #e9e2f2; }
  .hero { padding-top: 66px; text-align: center; }
  .eyebrow { display: flex; align-items: center; justify-content: center; gap: 9px; color: #b9a0ed; font-size: 11px; font-weight: 650; letter-spacing: 1.9px; }
  .status-dot { width: 6px; height: 6px; border-radius: 100%; background: #ba98ff; box-shadow: 0 0 12px #ab7cfa88; }
  h1 { margin: 26px 0 25px; font-size: clamp(54px, 7.5vw, 88px); line-height: 1.04; letter-spacing: -5px; font-weight: 650; }
  h1 span { color: #bfa1f6; }
  .hero-copy { max-width: 540px; margin: 0 auto 28px; font-size: 17px; color: #bcb4c8; }
  .hero-actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
  .button { min-height: 46px; display: inline-flex; gap: 20px; align-items: center; justify-content: center; padding: 12px 19px; border-radius: 7px; font-size: 13px; font-weight: 600; transition: background .2s; }
  .primary { color: #fff; background: #8853df; border: 1px solid #a879f0; box-shadow: 0 4px 20px #8b4ce221; }
  .primary:hover { background: #9a68ec; color: #fff; }
  .secondary { color: #ddd5e8; border: 1px solid #443b50; background: #211c2a; }
  .requirements { margin: 16px 0 50px; font-size: 11px; color: #aaa0b8; }
  .requirements a { text-decoration: underline; text-underline-offset: 3px; }
  .app-illustration { max-width: 920px; margin: auto; overflow: hidden; border: 1px solid #5b5069; border-radius: 13px; background: #24212c; box-shadow: 0 30px 90px #0005, 0 -10px 100px #9f6cf514; text-align: left; }
  .window-bar { height: 42px; display: flex; align-items: center; justify-content: space-between; padding: 0 15px; color: #bdb5c7; font-size: 11px; background: #302938; border-bottom: 1px solid #403748; }
  .traffic-lights { display: flex; gap: 6px; }
  .traffic-lights i { width: 9px; height: 9px; border-radius: 50%; background: #ef7771; }
  .traffic-lights i:nth-child(2) { background: #e2b45b; }
  .traffic-lights i:nth-child(3) { background: #76b586; }
  .window-menu { width: 39px; text-align: right; font-size: 16px; }
  .panes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: #51465f; }
  .pane { min-width: 0; background: #24212c; }
  .path { margin: 10px; padding: 8px 10px; display: flex; align-items: center; gap: 8px; border: 1px solid #51495b; border-radius: 5px; font-size: 11px; color: #c6bdcf; white-space: nowrap; }
  .path span:last-child { margin-left: auto; }
  .active .path { border-color: #9f76d3; background: #34283f; }
  .home-icon { color: #b993f0; font-size: 15px; }
  .column-labels, .file-row, .pane-status { display: flex; align-items: center; justify-content: space-between; }
  .column-labels { border-block: 1px solid #3c3545; padding: 7px 16px; font-size: 10px; color: #9c91aa; }
  .file-row { height: 36px; padding: 0 16px; font-size: 12px; color: #dfd8e8; }
  .file-row span:first-child { display: flex; align-items: center; }
  .file-row span:last-child { font-size: 10px; color: #a59bae; }
  .file-row b { display: inline-block; width: 25px; font-size: 18px; line-height: 1; font-weight: 400; }
  .folder { color: #bd9aed; }
  .archive { color: #c8ae79; }
  .file { color: #a39bae; }
  .selected { background: #7549a5; color: #fff; }
  .selected span:last-child, .selected b { color: #efe2ff; }
  .parent { color: #a79bad; }
  .pane-status { border-top: 1px solid #3c3545; margin-top: 18px; padding: 9px 14px; font-size: 9px; color: #a99eb4; }
  .function-bar { display: grid; grid-template-columns: repeat(6, 1fr); border-top: 1px solid #4c4257; background: #2d2735; }
  .function-bar span { display: flex; gap: 7px; justify-content: center; align-items: center; padding: 11px 4px; color: #b8adca; font-size: 9px; border-right: 1px solid #43394f; }
  .function-bar span:last-child { border-right: 0; }
  .function-bar b { color: #dfc8ff; font-weight: 500; }
  .illustration-caption { margin: 14px 0 0; color: #958a9f; font-size: 10px; }
  .features { padding-block: 108px 72px; }
  .section-intro { max-width: 560px; }
  .section-intro .eyebrow, .installation .eyebrow { justify-content: start; }
  h2 { font-size: clamp(30px, 4vw, 41px); line-height: 1.16; letter-spacing: -1.6px; font-weight: 600; margin-bottom: 20px; }
  .section-intro > p:last-child { max-width: 450px; color: #aaa1b8; font-size: 14px; }
  .feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; margin-top: 40px; }
  .feature-grid article { padding-top: 22px; border-top: 1px solid #44364f; }
  .feature-number { color: #aa85dc; font-size: 11px; font-variant-numeric: tabular-nums; }
  h3 { margin-block: 22px 12px; font-size: 17px; line-height: 1.4; font-weight: 550; letter-spacing: -.25px; }
  .feature-grid p { font-size: 13px; color: #aaa1b8; }
  .detail-strip { display: flex; flex-wrap: wrap; gap: 10px 24px; padding-top: 30px; color: #b4a9c1; font-size: 11px; }
  .detail-strip span::before { content: '+'; padding-right: 7px; color: #b18adb; }
  .installation { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; padding-block: 64px 86px; border-top: 1px solid #382f42; }
  .installation p:not(.eyebrow) { color: #aaa1b8; font-size: 14px; }
  .installation .install-note { font-size: 12px !important; color: #c1b2ce !important; }
  .text-link { display: inline-block; color: #c2a2f2; margin-top: 8px; font-size: 13px; }
  .source-card { align-self: center; border: 1px solid #42374d; padding: 27px; border-radius: 9px; background: #201b28; }
  .source-label { font-size: 10px; color: #ac91cc; letter-spacing: 1.5px; }
  .source-card p { margin-block: 16px; color: #e9e0f4 !important; font-size: 19px !important; line-height: 1.45; }
  pre { padding: 15px; margin: 20px 0; overflow-x: auto; border-radius: 5px; border: 1px solid #383040; background: #18131f; color: #c9b2e8; font-size: 10px; line-height: 1.9; }
  .source-card > a { font-size: 11px; color: #bcb0cc; }
  .site-footer { min-height: 100px; display: flex; align-items: center; justify-content: space-between; gap: 24px; border-top: 1px solid #382f42; }
  .site-footer .brand { font-size: 14px; }
  .site-footer p { margin: 0; color: #968b9f; font-size: 11px; }
  .site-footer > a:last-child { font-size: 11px; color: #b4a7c1; }
  @media (max-width: 900px) { .feature-grid { grid-template-columns: repeat(2, 1fr); } .installation { gap: 32px; } .site-footer { flex-wrap: wrap; padding-block: 24px; } .site-footer p { order: 3; width: 100%; } }
  @media (max-width: 600px) { .wrap { width: calc(100% - 36px); } .site-header { min-height: 80px; gap: 12px; } .brand { font-size: 16px; } nav { gap: 15px; font-size: 11px; } .nav-github { display: none; } .hero { padding-top: 42px; } h1 { letter-spacing: -2.8px; } .hero-copy { font-size: 15px; } .eyebrow { font-size: 9px; letter-spacing: 1.5px; } .hero-actions { flex-direction: column; max-width: 300px; margin-inline: auto; } .requirements { font-size: 10px; line-height: 1.8; margin-bottom: 36px; } .app-illustration { border-radius: 9px; } .window-bar { height: 32px; } .path { margin: 7px 5px; padding: 6px; font-size: 7px; gap: 3px; } .home-icon { font-size: 11px; } .column-labels { padding: 5px 8px; font-size: 8px; } .file-row { height: 29px; padding: 0 8px; font-size: 9px; } .file-row b { width: 17px; font-size: 14px; } .file-row span:last-child { font-size: 7px; } .pane-status { padding: 7px; font-size: 7px; margin-top: 12px; } .function-bar { grid-template-columns: repeat(3, 1fr); } .function-bar span { padding: 8px 2px; font-size: 8px; } .function-bar span:nth-child(-n+3) { border-bottom: 1px solid #43394f; } .function-bar span:nth-child(3) { border-right: 0; } .features { padding-top: 72px; padding-bottom: 48px; } .feature-grid { gap: 20px; margin-top: 28px; } h3 { font-size: 15px; } .feature-grid p { font-size: 12px; } .detail-strip { gap: 12px 20px; font-size: 10px; } .installation { grid-template-columns: 1fr; padding-block: 48px; gap: 30px; } .source-card { padding: 22px; } .site-footer p { font-size: 10px; } }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } .button { transition: none; } }
</style>
