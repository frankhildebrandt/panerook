---
import { repository } from '../data/site';

interface Props {
  title: string;
  description: string;
  page?: 'home' | 'documentation' | 'releases';
}

const { title, description, page = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const icon = `${base}/icon.svg`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17141e" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}/icon.png`, Astro.site)} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={icon} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt</a>
    <header class="site-header wrap">
      <a class="brand" href={`${base}/`} aria-label="PaneRook Startseite"><img src={icon} width="38" height="38" alt="" /><span>PaneRook</span></a>
      <nav aria-label="Hauptnavigation">
        <a href={`${base}/#funktionen`}>Funktionen</a>
        <a href={`${base}/dokumentation/`} aria-current={page === 'documentation' ? 'page' : undefined}>Dokumentation</a>
        <a href={`${base}/release-notes/`} aria-current={page === 'releases' ? 'page' : undefined}>Release Notes</a>
        <a class="nav-github" href={repository}>GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer wrap">
      <a class="brand" href={`${base}/`}><img src={icon} width="28" height="28" alt="" /><span>PaneRook</span></a>
      <p>Ein nativer Dateimanager. Inspiriert von Midnight Commander.</p>
      <a href={repository}>Auf GitHub mitarbeiten <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 32px; }
  :global(body) { margin: 0; color: #f3f0f8; background: #17141e; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible), :global(summary:focus-visible) { outline: 3px solid #c8b0ff; outline-offset: 5px; border-radius: 4px; }
  :global(a:hover) { color: #dccdff; }
  :global(p) { line-height: 1.7; }
  :global(h1), :global(h2), :global(h3), :global(p) { margin-top: 0; }
  :global(code), :global(kbd) { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  :global(.wrap) { width: min(1120px, calc(100% - 64px)); margin-inline: auto; }
  .skip-link { position: absolute; left: 16px; top: -60px; padding: 12px; background: #fff; color: #17141e; z-index: 10; }
  .skip-link:focus { top: 16px; }
  .site-header { min-height: 100px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-size: 18px; font-weight: 650; letter-spacing: -.5px; }
  .brand img { display: block; }
  .site-header nav { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; font-size: 13px; color: #bfb7cc; }
  .site-header nav [aria-current='page'] { color: #dcc6ff; text-decoration: underline; text-underline-offset: 7px; }
  .nav-github { padding: 9px 15px; border: 1px solid #48404f; border-radius: 7px; color: #e9e2f2; }
  .site-footer { min-height: 100px; display: flex; align-items: center; justify-content: space-between; gap: 24px; border-top: 1px solid #382f42; }
  .site-footer .brand { font-size: 14px; }
  .site-footer p { margin: 0; color: #968b9f; font-size: 11px; }
  .site-footer > a:last-child { font-size: 11px; color: #b4a7c1; }
  @media (max-width: 900px) {
    .site-header nav { gap: 12px 20px; }
    .site-footer { flex-wrap: wrap; padding-block: 24px; }
    .site-footer p { order: 3; width: 100%; }
  }
  @media (max-width: 600px) {
    :global(.wrap) { width: calc(100% - 36px); }
    .site-header { align-items: start; flex-direction: column; gap: 20px; padding-block: 22px; }
    .site-header nav { width: 100%; gap: 12px 20px; font-size: 12px; }
    .nav-github { display: none; }
    .site-footer p { font-size: 10px; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
</style>
